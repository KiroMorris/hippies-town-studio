# Copy this file to .env and fill in what you need. Every line is optional.

# Ports: API (localhost only) and the web app you open in the browser.
STUDIO_PORT=4322
STUDIO_WEB_PORT=5182

# Set a password to open the studio to your network or the internet (router port forward).
# Without it the studio only answers on this computer.
STUDIO_PASSWORD=

# Codex image jobs running at once (each spends your ChatGPT subscription quota).
STUDIO_CONCURRENCY=3
# STUDIO_JOB_TIMEOUT_MIN=12
# CODEX_HOME=/Users/you/.codex

# Your own folder of garment photos and masks (<style>__<color>__<front|back>[-mask].png).
# Without it the garment photos in assets/catalog.json are downloaded once into data/blanks.
# STUDIO_PRODUCT_SOURCES=

# fal.ai key for the "Upscale to 4K" button on a design.
FAL_KEY=

# Shopify push stays off until these are set (products are always created as drafts).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
